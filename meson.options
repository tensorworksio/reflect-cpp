option('json',                type: 'feature', value: 'enabled',  description: 'JSON support (bundled yyjson)')
option('cbor',                type: 'feature', value: 'disabled', description: 'CBOR support (requires jsoncons)')
option('ubjson',              type: 'feature', value: 'disabled', description: 'UBJSON support (requires jsoncons)')
option('msgpack',             type: 'feature', value: 'disabled', description: 'MessagePack support (requires msgpack-c)')
option('toml',                type: 'feature', value: 'disabled', description: 'TOML support (requires tomlplusplus)')
option('xml',                 type: 'feature', value: 'disabled', description: 'XML support (requires pugixml)')
option('yaml',                type: 'feature', value: 'disabled', description: 'YAML support (requires yaml-cpp)')
option('cereal',              type: 'feature', value: 'disabled', description: 'Cereal support (requires cereal)')
option('flexbuffers',         type: 'feature', value: 'disabled', description: 'FlexBuffers support (requires flatbuffers)')
option('boost_serialization', type: 'feature', value: 'disabled', description: 'Boost.Serialization support (requires Boost)')
